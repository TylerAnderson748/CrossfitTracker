# Copy this file to .env.local and fill in your values

# xAI API Key (required for AI Coach features)
# Get your key from: https://console.x.ai/
NEXT_PUBLIC_XAI_API_KEY=your_xai_api_key_here

# Optional: override the AI models (defaults shown)
# The fast model keeps AI Coach responses snappy; the fallback is used
# automatically if the fast model name is ever rejected by the API.
# NEXT_PUBLIC_XAI_MODEL=grok-4-fast-non-reasoning
# NEXT_PUBLIC_XAI_FALLBACK_MODEL=grok-4-latest

# Cron Secret (for scheduled AI suggestion generation)
# Generate a random string for security
CRON_SECRET=your_random_cron_secret_here

# Firebase Configuration (already set in lib/firebase.ts, but can be overridden here)
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
